{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "smartnews/aggregator",
    "type": "project",
    "description": "SmartNews Aggregator modular monolith.",
    "keywords": ["laravel", "news", "aggregator"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-sockets": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "php-amqplib/php-amqplib": "^3.6",
        "saloonphp/saloon": "^3.0",
        "filament/filament": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.5.3",
        "rector/rector": "^1.2",
        "vimeo/psalm": "^6.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "src/Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "sh scripts/dev.sh"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:arch": "pest --group=arch",
        "test:acceptance": "pest --group=acceptance",
        "lint": "pint",
        "lint:check": "pint --test",
        "analyze": "phpstan analyse",
        "rector": "rector",
        "rector:check": "rector --dry-run",
        "psalm": "psalm",
        "psalm:taint": "psalm --taint-analysis",
        "qa:validate": "composer validate --strict",
        "qa:audit": "composer audit --format=plain",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
