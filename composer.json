{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "smartnews/aggregator",
    "type": "project",
    "description": "SmartNews Aggregator modular monolith.",
    "keywords": [
        "laravel",
        "news",
        "aggregator"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sockets": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "filament/filament": "^5.0",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.14",
        "laravel/tinker": "^2.10.1",
        "php-amqplib/php-amqplib": "^3.6",
        "saloonphp/saloon": "^4.0",
        "spiral/roadrunner": "^2025.1",
        "spiral/roadrunner-cli": "^2.6.0",
        "spiral/roadrunner-http": "^3.3.0",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^14.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "deptrac/deptrac": "^4.6",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/telescope": "^5.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5.3",
        "psalm/plugin-laravel": "^3.0",
        "rector/rector": "^2.0",
        "vimeo/psalm": "^6.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "src/Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "sh scripts/dev.sh"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "./vendor/bin/pest tests/Unit tests/Feature --exclude-group=acceptance"
        ],
        "test:coverage": "sh scripts/test-coverage.sh",
        "test:arch": "@php -d memory_limit=512M ./vendor/bin/pest --group=arch",
        "test:acceptance": "pest --group=acceptance",
        "lint": "pint",
        "lint:check": "pint --test",
        "analyze": "phpstan analyse --memory-limit=2G",
        "rector": "rector",
        "rector:check": "rector --dry-run",
        "psalm": "psalm",
        "psalm:taint": "psalm --taint-analysis",
        "qa:validate": "composer validate --strict",
        "qa:audit": "composer audit --format=plain",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
