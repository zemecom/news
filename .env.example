APP_NAME=SmartNews
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Moscow
VITE_PORT=5173
APP_PORT=8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smartnews
DB_USERNAME=smartnews
DB_PASSWORD=smartnews

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=rabbitmq

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
RABBITMQ_QUEUE_CONNECTION=default
RABBITMQ_QUEUE_EXCHANGE=news.jobs
RABBITMQ_QUEUE_EXCHANGE_TYPE=direct
RABBITMQ_QUEUE_ROUTING_KEY=%s
RABBITMQ_RETRY_AFTER=90

# Xdebug
WITH_XDEBUG=0
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_FETCH_LIMIT=50

PROMETHEUS_PREFIX=news_

ADMIN_AUTO_LOGIN=false
TELESCOPE_ENABLED=true
