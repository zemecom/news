APP_NAME=SmartNews
APP_ENV=local
DOCKER_BUILD_TARGET=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Europe/Moscow
VITE_PORT=5173


LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smartnews
DB_USERNAME=smartnews
DB_PASSWORD=smartnews

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=rabbitmq

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=smartnews
RABBITMQ_PASSWORD=smartnews
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
RABBITMQ_QUEUE_CONNECTION=default
RABBITMQ_QUEUE_EXCHANGE=news.jobs
RABBITMQ_QUEUE_EXCHANGE_TYPE=direct
RABBITMQ_QUEUE_ROUTING_KEY=%s
RABBITMQ_RETRY_AFTER=180

POSTGRES_BIND=127.0.0.1:5432
REDIS_BIND=127.0.0.1:6379
RABBITMQ_BIND=127.0.0.1:5672
RABBITMQ_MANAGEMENT_BIND=127.0.0.1:15672

# Xdebug
WITH_XDEBUG=0
WITH_XDEBUG_WORKER=0
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_FETCH_LIMIT=50

CRAWLER_ALLOWLIST=
CRAWLER_RSS_ALLOWLIST=
CRAWLER_TELEGRAM_ALLOWLIST=t.me
CRAWLER_ALLOWED_SOURCE_SCHEMES=https
CRAWLER_ALLOWED_URL_SCHEMES=http,https
CRAWLER_DENY_PRIVATE_HOSTS=true
CRAWLER_SANITIZE_MAX_TEXT_LENGTH=20000
CRAWLER_SANITIZE_MAX_CATEGORY_LENGTH=64
CRAWLER_HEALTH_BACKOFF_ENABLED=true
CRAWLER_HEALTH_BACKOFF_AFTER_STREAK=2
CRAWLER_HEALTH_BASE_BACKOFF_MINUTES=5
CRAWLER_HEALTH_MAX_BACKOFF_MINUTES=720

PROMETHEUS_PREFIX=news_

ADMIN_AUTO_LOGIN=false
OCTANE_SERVER=roadrunner
DEBUGBAR_ENABLED=false
DEBUGBAR_ROUTE_DOMAIN=localhost
TELESCOPE_ENABLED=true
