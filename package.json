{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build:prod",
        "build:prod": "vite build",
        "dev": "vite",
        "dev:web": "npm run dev --workspace @smartnews/web -- --hostname 0.0.0.0 --port 3000",
        "dev:admin": "npm run dev --workspace @smartnews/admin -- --hostname 0.0.0.0 --port 3001",
        "build:web": "npm run build --workspace @smartnews/web",
        "build:admin": "npm run build --workspace @smartnews/admin"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
