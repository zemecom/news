#!/bin/sh

# Auto-fix code style (Pint) before committing
echo "🎨 Formatting code..."
docker compose exec -T app vendor/bin/pint --quiet 2>/dev/null
git add -u

# Run the full CI Check suite to ensure the commit is fully working
echo "🔍 Running comprehensive CI checks for commit..."
make ci-check

if [ $? -ne 0 ]; then
    echo "❌ CI checks failed! Commit aborted. Please fix the errors."
    exit 1
fi

echo "✅ All CI checks passed! Commit successful."
